{
  "version": 2,
  "builds": [
    {
      "src": "BE/src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["BE/**"]
      }
    },
    {
      "src": "FE/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "cd FE && npm install && npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "BE/src/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "FE/dist/$1"
    }
  ]
}